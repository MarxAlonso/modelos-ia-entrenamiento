---
import BaseLayout from '../layouts/BaseLayout.astro';

const ejemplos = [
  'La talla vino muy pequeña y la tela se siente barata, no lo volvería a comprar.',
  'Me encantó, la calidad es excelente y llegó antes de lo esperado.',
  'Está bien por el precio, aunque el color es distinto al de la foto.',
  'Beautiful watch, works perfectly and looks expensive. Love it!',
];
---

<BaseLayout
  title="Analizar reseñas"
  description="Un modelo afinado lee una reseña y estima las estrellas y si el cliente recomendaría el producto."
  activo="resenas"
>
  <section class="contenedor cab-r">
    <p class="eyebrow">Modelo de calidad</p>
    <h1>Lee la reseña, estima la satisfacción</h1>
    <p class="lead">Un Transformer (MiniLM) afinado con 90 mil reseñas estima las estrellas (1-5) y la probabilidad de que el cliente recomiende el producto. Funciona en español y en inglés.</p>
  </section>

  <div class="contenedor rejilla-r">
    <section class="tarjeta caja">
      <form id="form" autocomplete="off">
        <label for="texto">Escribe o pega una reseña</label>
        <textarea id="texto" rows="5" placeholder="«Me llegó rápido y la calidad es muy buena…»" minlength="3" required></textarea>
        <div class="ejemplos">
          <span>Prueba con:</span>
          {ejemplos.map((e) => <button type="button" class="ej" data-t={e}>{e.length > 46 ? e.slice(0, 45) + '…' : e}</button>)}
        </div>
        <button class="btn btn-primario" type="submit">Analizar reseña</button>
      </form>
    </section>

    <section class="tarjeta resultado" id="resultado" aria-live="polite">
      <div class="vacio"><h3>Aquí verás el análisis</h3><p>Las estrellas estimadas, cuánta confianza tiene y si el cliente recomendaría el producto.</p></div>
    </section>
  </div>

  <script>
    import { analizarResena } from '../lib/api';
    import { esc, num, pct, estrellas } from '../lib/ui';

    const form = document.getElementById('form') as HTMLFormElement;
    const texto = document.getElementById('texto') as HTMLTextAreaElement;
    const salida = document.getElementById('resultado')!;

    document.querySelectorAll<HTMLButtonElement>('.ej').forEach((b) =>
      b.addEventListener('click', () => { texto.value = b.dataset.t || ''; form.requestSubmit(); }),
    );

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const t = texto.value.trim();
      if (t.length < 3) return;
      salida.innerHTML = '<div class="esqueleto" style="height:260px"></div><p class="espera">Analizando… la primera consulta carga el modelo y puede tardar hasta un minuto; las siguientes tardan 1 segundo.</p>';
      try {
        const r = await analizarResena(t);
        const probs: number[] = r.probabilidades_estrellas || [];
        const recomienda = r.recomendaria ?? 0;
        const veredicto = recomienda >= 0.5 ? 'Sí lo recomendaría' : 'No lo recomendaría';
        const color = recomienda >= 0.5 ? 'verde' : '';
        salida.innerHTML = `
          <div class="res-cab">
            <div>
              <p class="eyebrow">Estrellas estimadas</p>
              <div class="grandes"><span>${estrellas(r.estrellas)}</span><strong>${r.estrellas}</strong></div>
              <p class="sub">Confianza ${pct(r.confianza ?? 0, 0)}</p>
            </div>
            <div class="veredicto ${color}">
              <span class="chip ${color || 'gris'}">${veredicto}</span>
              <strong>${pct(recomienda)}</strong>
              <small>probabilidad de recomendarlo</small>
            </div>
          </div>
          <div class="dist">
            ${probs.map((p, i) => `<div class="d"><span>${i + 1}★</span><div class="barra"><i style="width:${(p * 100).toFixed(1)}%"></i></div><b>${num(p * 100, 0)} %</b></div>`).join('')}
          </div>
          ${r.laya ? `<p class="ref">Referencia, Laya sin afinar: ${num(r.laya.rating_estimado, 2)} estrellas · ${pct(r.laya.recomendaria ?? 0, 0)} recomendaría.</p>` : ''}`;
      } catch (e: any) {
        salida.innerHTML = e?.sinBackend
          ? '<div class="aviso"><strong>No se pudo conectar con el modelo.</strong><br />Inicia el backend (<code>iniciar_demo.cmd</code>) y vuelve a intentar.</div>'
          : `<div class="aviso">${esc(e?.message || 'Error')}</div>`;
      }
    });
  </script>
</BaseLayout>

<style is:global>
  .cab-r {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }
  .cab-r h1 {
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    max-width: 16em;
  }
  .rejilla-r {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
  }
  .caja,
  .resultado {
    padding: 1.6rem;
  }
  .caja label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .caja textarea {
    width: 100%;
    resize: vertical;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    border: 1.5px solid var(--line);
    font: inherit;
    background: #fffdfb;
  }
  .caja textarea:focus {
    border-color: var(--terra);
  }
  .ejemplos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    margin: 0.9rem 0 1.2rem;
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .ej {
    border: 1.5px solid var(--line);
    background: #fff;
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    color: var(--ink-2);
    transition: border-color 0.15s, background 0.15s;
  }
  .ej:hover {
    border-color: var(--terra);
    background: var(--terra-s);
  }
  .res-cab {
    display: flex;
    justify-content: space-between;
    gap: 1.4rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .grandes {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }
  .grandes span {
    color: #f4a316;
    font-size: 1.7rem;
    letter-spacing: 0.06em;
  }
  .grandes strong {
    font-size: 3rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .veredicto {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1.1rem;
    border-radius: 18px;
    background: var(--terra-s);
  }
  .veredicto.verde {
    background: var(--teal-s);
  }
  .veredicto strong {
    font-size: 2rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .veredicto small {
    color: var(--ink-3);
  }
  .dist {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.4rem;
  }
  .d {
    display: grid;
    grid-template-columns: 2.2rem 1fr 3rem;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .espera {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .ref {
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .rejilla-r {
      grid-template-columns: 1fr;
    }
  }
</style>
