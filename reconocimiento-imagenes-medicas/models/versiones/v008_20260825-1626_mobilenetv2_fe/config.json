{
  "version": "v008",
  "dataset": "v2_nih_chest_xray14",
  "manifiesto": "data\\manifiestos\\v2_splits_duros.csv",
  "base_anterior": null,
  "arquitectura": "mobilenetv2_feature_extraction",
  "base_imagenet": "mobilenetv2",
  "base_congelada": true,
  "capas_descongeladas": 0,
  "img_size": [
    224,
    224
  ],
  "batch_size": 32,
  "epochs": 20,
  "epochs_reales": 7,
  "learning_rate": 0.001,
  "dropout_cabeza": 0.3,
  "loss": "binary_crossentropy",
  "normalizacion": "mobilenetv2",
  "recorte_borde_px": 0,
  "dataset_variante": "v2duros",
  "sobremuestreo_positivos": 2,
  "augmentacion": [
    "rotation_5deg",
    "zoom_10",
    "translation_10",
    "contrast_8"
  ],
  "class_weights": {
    "0": 0.65,
    "1": 2.169
  },
  "early_stopping": {
    "monitor": "val_auc",
    "mode": "max",
    "patience": 6
  },
  "reduce_lr": true,
  "semilla": 42,
  "notas": "NIH con negativos duros (3000 infiltraciones/consolidaciones como no-neumonia en train/val) + oversampling de positivos x2. Mismo test congelado que v007: comparacion directa."
}