---
import Base from "../layouts/Base.astro";
---
<Base titulo="Demo">
  <p class="ceja">demo local · herramienta académica, no diagnóstico real</p>
  <h1>Sube una radiografía</h1>
  <p class="bajada">
    Por defecto la analiza el <b>modelo universal</b>: un único archivo TensorFlow
    entrenado sobre los tres dominios del proyecto a la vez, así que no hace falta
    saber de qué hospital viene la placa. Devuelve clase, probabilidad y el mapa
    Grad-CAM de dónde miró para decidir.
  </p>

  <div id="modelos" class="selector-fila">
    <span class="ceja cargando">consultando modelos disponibles…</span>
  </div>
  <p id="ficha-campeon" class="ceja ficha" hidden></p>

  <div id="zona" class="panel zona" tabindex="0" role="button" aria-label="subir imagen">
    <input type="file" id="archivo" accept="image/*,.dcm,.dicom" hidden />
    <span class="zona-texto">Arrastra una imagen aquí o <u>haz clic para elegir</u></span>
    <small class="ceja" style="margin-top:6px">jpg / png / webp / bmp / dicom · máx 15 MB</small>
  </div>

  <button id="analizar" class="boton" disabled>Analizar radiografía</button>
  <p id="estado" class="bajada" style="margin-top:10px; min-height:1.4em"></p>

  <section id="resultado" class="rejilla dos" hidden style="margin-top:18px">
    <div class="panel" style="padding:18px 20px">
      <p class="ceja">veredicto del modelo</p>
      <div id="clase" style="font-family:var(--mono); font-size:30px; font-weight:500"></div>
      <div style="height:14px; background:#0d1117; border-radius:999px; border:1px solid var(--regla); overflow:hidden; margin:10px 0 4px">
        <div id="barra" style="height:100%; width:0%; transition:width .6s ease"></div>
      </div>
      <div style="font-family:var(--mono); font-size:11px; color:var(--tinta-2)" id="detalle"></div>
      <p id="aviso-entrada" class="aviso" hidden></p>
    </div>
    <div class="rejilla dos">
      <figure class="panel" style="padding:10px; margin:0">
        <img id="img-original" class="artefacto" alt="original" />
        <figcaption>original</figcaption>
      </figure>
      <figure class="panel" style="padding:10px; margin:0">
        <img id="img-gradcam" class="artefacto" alt="grad-cam" />
        <figcaption>Grad-CAM</figcaption>
      </figure>
    </div>
  </section>

  <style>
    .selector-fila { display: flex; gap: 10px; margin: 20px 0 8px; flex-wrap: wrap; }
    .selector input { position: absolute; opacity: 0; }
    .selector span {
      display: block; border: 1px solid var(--regla); border-radius: 6px;
      padding: 10px 14px; cursor: pointer; font-family: var(--mono); font-size: 11.5px;
      color: var(--tinta-2);
    }
    .selector span b { display: block; font-weight: 500; color: var(--tinta); }
    .selector small { font-size: 10px; letter-spacing: .06em; }
    .selector input:checked + span { border-color: var(--v1); color: var(--tinta); background: #101a1f; }
    .selector input:focus-visible + span { outline: 2px solid var(--v1); }
    .selector.no-disponible span { opacity: .35; cursor: not-allowed; }
    .selector .marca { color: var(--v1); letter-spacing: .06em; }

    .ficha { margin: 2px 0 0; font-size: 10.5px; color: var(--tinta-2); }

    .zona {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      min-height: 150px; margin-top: 12px; cursor: pointer;
      border-style: dashed !important;
      transition: border-color .2s ease, background .2s ease;
    }
    .zona.arrastre { border-color: var(--v1) !important; background: #101a1f; }
    .zona-texto { font-family: var(--mono); font-size: 12.5px; color: var(--tinta); }
    .zona u { text-decoration-color: var(--v1); }

    .boton {
      margin-top: 16px; font-family: var(--mono); font-size: 13px; letter-spacing: .1em;
      padding: 11px 26px; border-radius: 5px; cursor: pointer;
      background: var(--v1); color: #08201d; border: none; font-weight: 600;
    }
    .boton:disabled { opacity: .35; cursor: not-allowed; }

    .aviso {
      margin: 12px 0 0; padding: 9px 11px; border-radius: 5px;
      border: 1px solid #6b4a1f; background: #1d1608;
      font-family: var(--mono); font-size: 11px; line-height: 1.5; color: #e8c07d;
    }

    #resultado img { max-height: 300px; object-fit: contain; }
  </style>

  <script>
    const API = "http://127.0.0.1:8000";

    const zona = document.getElementById("zona") as HTMLElement;
    const inputArchivo = document.getElementById("archivo") as HTMLInputElement;
    const boton = document.getElementById("analizar") as HTMLButtonElement;
    const estado = document.getElementById("estado") as HTMLParagraphElement;
    const contenedorModelos = document.getElementById("modelos") as HTMLElement;
    const fichaCampeon = document.getElementById("ficha-campeon") as HTMLParagraphElement;

    let archivo: File | null = null;

    const escapar = (t: string) =>
      t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

    // ------------------------------------------------------------------
    // Selector de modelo: lo dicta el servidor, no el HTML. Así promover un
    // campeón nuevo (src/promover_campeon.py) se refleja aquí sin tocar la UI.
    // ------------------------------------------------------------------
    async function cargarModelos() {
      try {
        const dominios = await (await fetch(`${API}/api/dominios`)).json();
        contenedorModelos.innerHTML = dominios
          .map((d: any) => {
            const marca = d.universal ? '<small class="marca">recomendado</small>' : "";
            const etiqueta = d.version ? `${d.etiqueta} · ${d.version}` : d.etiqueta;
            const desc = d.disponible ? d.desc : "sin promover todavía";
            return `<label class="selector ${d.disponible ? "" : "no-disponible"}" title="${escapar(d.carpeta)}">
              <input type="radio" name="dominio" value="${d.id}"
                ${d.por_defecto && d.disponible ? "checked" : ""} ${d.disponible ? "" : "disabled"} />
              <span><b>${escapar(etiqueta)}</b><small>${escapar(desc)}</small>${marca}</span>
            </label>`;
          })
          .join("");

        // Si el universal aún no está promovido, no dejamos la página sin selección.
        if (!document.querySelector('input[name="dominio"]:checked')) {
          const primero = document.querySelector(
            'input[name="dominio"]:not([disabled])'
          ) as HTMLInputElement | null;
          if (primero) primero.checked = true;
        }

        const r = await fetch(`${API}/api/campeon`);
        if (r.ok) {
          const c = await r.json();
          fichaCampeon.textContent =
            `campeón universal ${c.version} · ${c.arquitectura} · f1 macro ${c.f1_macro} · ` +
            `int8 ${c.int8.tamano_mb} MB · ${c.int8.latencia_ms} ms · umbral ${c.contrato_inferencia.umbral_decision}`;
          fichaCampeon.hidden = false;
        }
      } catch {
        contenedorModelos.innerHTML =
          '<span class="ceja">servidor apagado · ejecuta <b>python src/servidor_demo.py</b> y recarga</span>';
      }
    }
    cargarModelos();

    // FastAPI devuelve {detail: "texto"} en HTTPException y {detail: [..]} en
    // errores de validación (422); un 500 sin manejar puede no traer JSON.
    async function mensajeDeError(r: Response): Promise<string> {
      try {
        const cuerpo = await r.json();
        if (typeof cuerpo.detail === "string") return cuerpo.detail;
        if (Array.isArray(cuerpo.detail)) return cuerpo.detail.map((e: any) => e.msg).join("; ");
      } catch {}
      return `el servidor respondió HTTP ${r.status}`;
    }

    function dominioElegido(): string {
      const elegido = document.querySelector('input[name="dominio"]:checked') as HTMLInputElement | null;
      return elegido?.value ?? "auto";
    }
    function asignar(f?: File | null) {
      archivo = f ?? null;
      boton.disabled = !archivo;
      if (archivo) estado.textContent = `listo: ${archivo.name} (${(archivo.size / 1024).toFixed(0)} KB)`;
    }

    zona.addEventListener("click", () => inputArchivo.click());
    zona.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") inputArchivo.click(); });
    inputArchivo.addEventListener("change", () => asignar(inputArchivo.files?.[0]));
    for (const ev of ["dragover", "dragenter"]) {
      zona.addEventListener(ev, (e) => { e.preventDefault(); zona.classList.add("arrastre"); });
    }
    for (const ev of ["dragleave", "drop"]) {
      zona.addEventListener(ev, (e) => { e.preventDefault(); zona.classList.remove("arrastre"); });
    }
    zona.addEventListener("drop", (e) => {
      const ev = e as DragEvent;
      asignar(ev.dataTransfer?.files?.[0]);
    });

    boton.addEventListener("click", async () => {
      if (!archivo) return;
      boton.disabled = true;
      estado.textContent = "procesando…";
      const fd = new FormData();
      fd.append("imagen", archivo);
      fd.append("dominio", dominioElegido());

      try {
        const r = await fetch(`${API}/api/predict`, { method: "POST", body: fd });
        if (!r.ok) throw new Error(await mensajeDeError(r));
        const d = await r.json();

        const neumonia = d.clase === "PNEUMONIA";
        const colorClase = neumonia ? "#e0684b" : "#58c97b";
        document.getElementById("clase")!.textContent = d.clase;
        document.getElementById("clase")!.style.color = colorClase;
        const barra = document.getElementById("barra")!;
        barra.style.width = `${d.probabilidad}%`;
        barra.style.background = colorClase;
        document.getElementById("detalle")!.textContent =
          // La decisión la toma el int8 (pasos de 1/256); el fp32 da el valor fino.
          `probabilidad PNEUMONIA ${d.probabilidad}% (fp32 ${d.probabilidad_gradcam_keras}%) · ` +
          `umbral ${d.umbral} · ${d.latencia_ms} ms · ` +
          `modelo ${d.modelo.version} int8 · entrada ${d.entrada.formato} ${d.entrada.resolucion}`;

        const aviso = document.getElementById("aviso-entrada") as HTMLParagraphElement;
        aviso.textContent = d.entrada.aviso_entrada ?? "";
        aviso.hidden = !d.entrada.aviso_entrada;

        (document.getElementById("img-original") as HTMLImageElement).src = d.original_png;
        (document.getElementById("img-gradcam") as HTMLImageElement).src = d.gradcam_png;
        document.getElementById("resultado")!.hidden = false;
        estado.textContent = "";
      } catch (err: any) {
        estado.textContent =
          err.message === "Failed to fetch"
            ? "no pude contactar al servidor ¿ejecutaste python src/servidor_demo.py?"
            : `error: ${err.message}`;
      } finally {
        boton.disabled = false;
      }
    });
  </script>
</Base>
