---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  activo?: 'inicio' | 'perfil' | 'metricas' | 'resenas';
}

const { title, description = '', activo = 'inicio' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://srp-demo.pages.dev');
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E4572E" />
    <title>{title} · SRP</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/3d/perfiles/mujer-calzado.webp" />
  </head>
  <body>
    <Navbar activo={activo} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbf7f3;
    --surface: #ffffff;
    --ink: #2a2421;
    --ink-2: #5a504a;
    --ink-3: #8b8178;
    --line: #eadfd3;
    --terra: #e4572e;
    --terra-d: #c9431c;
    --terra-s: #fde9e1;
    --teal: #2a9d8f;
    --teal-s: #dff2ef;
    --sun: #ffc857;
    --sun-s: #fff3d6;
    --indigo: #5b5bd6;
    --indigo-s: #e8e8fb;
    --radio: 22px;
    --sombra-1: 0 1px 2px rgba(42, 36, 33, 0.05), 0 8px 24px rgba(42, 36, 33, 0.06);
    --sombra-2: 0 2px 4px rgba(42, 36, 33, 0.06), 0 22px 50px rgba(42, 36, 33, 0.13);
    --fuente: 'Segoe UI Variable Display', 'Segoe UI', system-ui, -apple-system, 'Helvetica Neue', Roboto, Arial, sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    font-family: var(--fuente);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  main {
    min-height: 70vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 800;
  }

  p {
    margin: 0;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .contenedor {
    width: min(1180px, 100% - 2.5rem);
    margin-inline: auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terra);
  }

  .lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: var(--ink-2);
    max-width: 38em;
  }

  /* botones */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 0;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.18s, box-shadow 0.18s, background 0.18s;
  }
  .btn:focus-visible,
  .chip-btn:focus-visible,
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--terra) 55%, white);
    outline-offset: 3px;
  }
  .btn-primario {
    background: var(--terra);
    color: #fff;
    box-shadow: 0 10px 24px rgba(228, 87, 46, 0.35);
  }
  .btn-primario:hover {
    background: var(--terra-d);
    transform: translateY(-2px);
  }
  .btn-suave {
    background: #fff;
    color: var(--ink);
    border: 1.5px solid var(--line);
  }
  .btn-suave:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--terra-s);
    color: var(--terra-d);
  }
  .chip.verde {
    background: var(--teal-s);
    color: #1c6f65;
  }
  .chip.sol {
    background: var(--sun-s);
    color: #8a5a00;
  }
  .chip.indigo {
    background: var(--indigo-s);
    color: #3b3ba8;
  }
  .chip.gris {
    background: #f1ebe4;
    color: var(--ink-2);
  }

  .tarjeta {
    background: var(--surface);
    border-radius: var(--radio);
    box-shadow: var(--sombra-1);
    border: 1px solid rgba(234, 223, 211, 0.7);
  }

  /* ilustración 3D sobre un fondo pastel, con sombra de contacto */
  .arte {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: calc(var(--radio) - 4px);
    background: var(--tinte, var(--sun-s));
    overflow: hidden;
    isolation: isolate;
  }
  .arte::before {
    content: '';
    position: absolute;
    inset: auto 12% 9% 12%;
    height: 11%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(42, 36, 33, 0.28), rgba(42, 36, 33, 0));
    filter: blur(3px);
    z-index: 0;
    transition: transform 0.35s, opacity 0.35s;
  }
  .arte::after {
    content: '';
    position: absolute;
    width: 86%;
    aspect-ratio: 1;
    left: 7%;
    top: 4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0));
    z-index: 0;
  }
  .arte > img {
    position: relative;
    z-index: 1;
    width: 92%;
    height: 92%;
    object-fit: contain;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    filter: drop-shadow(0 10px 10px rgba(42, 36, 33, 0.12));
  }
  .arte.flota > img {
    animation: flotar 6s ease-in-out infinite;
  }
  @keyframes flotar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2.5%);
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .sub {
    color: var(--ink-3);
    font-size: 0.9rem;
  }
  .barra {
    flex: 1;
    height: 6px;
    border-radius: 99px;
    background: #f1ebe4;
    overflow: hidden;
  }
  .barra i {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--terra), #ffa45f);
  }

  .esqueleto {
    background: linear-gradient(100deg, #f1e9e0 30%, #fbf6f0 50%, #f1e9e0 70%);
    background-size: 200% 100%;
    animation: brillo 1.3s linear infinite;
    border-radius: 14px;
  }
  @keyframes brillo {
    to {
      background-position: -200% 0;
    }
  }

  .vacio {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--ink-2);
  }
  .vacio h3 {
    color: var(--ink);
    margin-bottom: 0.4rem;
  }

  .aviso {
    border-radius: 16px;
    padding: 1rem 1.2rem;
    background: var(--sun-s);
    color: #6b4700;
    border: 1px solid #f1d58c;
    font-size: 0.95rem;
  }
  .aviso code {
    background: rgba(255, 255, 255, 0.7);
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
