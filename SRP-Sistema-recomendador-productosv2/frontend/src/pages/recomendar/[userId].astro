---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const userId = Astro.params.userId;

export function getStaticPaths() {
  return [
    { params: { userId: 'AE22RP65USPRTIPUADYJRFOWCMHQ' } },
    { params: { userId: 'USER_EXAMPLE_1' } },
    { params: { userId: 'USER_EXAMPLE_2' } },
  ];
}
---

<BaseLayout title={`Usuario ${userId}`} description={`Recomendaciones para el usuario ${userId}`}>
  <Navbar />
  
  <div class="container">
    <div class="page-header">
      <h1>Recomendaciones para {userId}</h1>
      <p>Productos recomendados basados en el historial de compras del usuario.</p>
    </div>

    <div id="recomendaciones-container">
      <div class="empty-state">Cargando...</div>
    </div>
  </div>

  <Footer />

  <script>
    async function cargarRecomendaciones() {
      const container = document.getElementById('recomendaciones-container');
      const userId = '{userId}';
      
      try {
        const res = await fetch(`/api/recomendar/usuario/${encodeURIComponent(userId)}`);
        if (!res.ok) throw new Error('No se pudieron cargar las recomendaciones');
        const data = await res.json();

        container.innerHTML = '';
        
        if (data.recomendaciones && data.recomendaciones.length > 0) {
          const header = document.createElement('h2');
          header.textContent = `Top ${data.recomendaciones.length} productos`;
          header.style.fontSize = '1.5rem';
          header.style.marginBottom = '1.5rem';
          container.appendChild(header);

          const grid = document.createElement('div');
          grid.className = 'grid-4';
          
          data.recomendaciones.forEach((p, i) => {
            const card = document.createElement('div');
            card.className = 'product-card';
            card.innerHTML = `
              <div class="card-rank">${i + 1}</div>
              <div class="card-body">
                <h3 class="card-title">${escapeHtml(p.titulo)}</h3>
                <div class="card-meta">
                  <span class="chip">${escapeHtml(p.categoria)}</span>
                  <span class="chip">${escapeHtml(p.publico)}</span>
                  ${p.precio !== null && p.precio !== undefined ? `<span class="chip price">$${p.precio}</span>` : ''}
                </div>
                <div class="card-rating">
                  <span class="stars">${'★'.repeat(Math.round(p.rating_promedio || 0))}${'☆'.repeat(5 - Math.round(p.rating_promedio || 0))}</span>
                  <span class="rating-text">${(p.rating_promedio || 0).toFixed(1)}★</span>
                  ${p.numero_resenas !== undefined ? `<span class="review-count">(${p.numero_resenas} reseñas)</span>` : ''}
                </div>
                <div class="card-score">
                  <span class="score-label">Puntaje</span>
                  <span class="score-value">${(p.puntaje || 0).toFixed(2)}</span>
                </div>
                ${p.porque ? `
                <div class="card-why">
                  <span class="why-label">Por qué:</span>
                  ${p.porque.parecido_a ? `<span class="why-text">Similar a: ${escapeHtml(p.porque.parecido_a.titulo)}</span>` : ''}
                  ${p.porque.popular ? `<span class="why-text">Popular: puesto #${p.porque.popular.puesto}</span>` : ''}
                </div>` : ''}
              </div>
            `;
            grid.appendChild(card);
          });
          
          container.appendChild(grid);
        } else {
          container.innerHTML = '<div class="empty-state"><h3>Sin recomendaciones</h3><p>No se encontraron productos para este usuario.</p></div>';
        }
      } catch (err) {
        container.innerHTML = `<div class="empty-state"><h3>Error</h3><p>${escapeHtml(err.message)}</p></div>`;
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    cargarRecomendaciones();
  </script>

  <style>
    .search-box {
      max-width: 500px;
      margin: 2rem auto 3rem;
      position: relative;
    }

    .search-box input {
      width: 100%;
      padding: 1rem 1.5rem;
      border: 2px solid #e5e7eb;
      border-radius: 0.75rem;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .search-box input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .search-box button {
      position: absolute;
      right: 0.5rem;
      top: 0.5rem;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 0.5rem;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      cursor: pointer;
    }

    .search-box button:hover {
      background: #1d4ed8;
    }

    .product-card {
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 0.75rem;
      padding: 1.25rem;
      transition: all 0.2s;
      position: relative;
      height: 100%;
    }

    .product-card:hover {
      border-color: #2563eb;
      box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.1);
      transform: translateY(-2px);
    }

    .card-rank {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 2rem;
      height: 2rem;
      background: #f3f4f6;
      color: #6b7280;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.875rem;
    }

    .card-body {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .card-title {
      font-size: 1rem;
      font-weight: 600;
      color: #111827;
      margin: 0;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      padding: 0.1875rem 0.625rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 500;
      background: #eff6ff;
      color: #1d4ed8;
    }

    .chip.price {
      background: #f0fdf4;
      color: #166534;
    }

    .card-rating {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .stars {
      font-size: 1rem;
      color: #fbbf24;
    }

    .rating-text {
      font-size: 0.875rem;
      font-weight: 600;
      color: #374151;
    }

    .review-count {
      font-size: 0.8rem;
      color: #6b7280;
    }

    .card-score {
      display: flex;
      align-items: baseline;
      gap: 0.25rem;
      margin-top: 0.25rem;
    }

    .score-label {
      font-size: 0.75rem;
      color: #6b7280;
    }

    .score-value {
      font-size: 1.125rem;
      font-weight: 700;
      color: #2563eb;
    }

    .card-why {
      margin-top: 0.5rem;
      padding: 0.625rem;
      background: #f9fafb;
      border-radius: 0.5rem;
      font-size: 0.8rem;
      color: #4b5563;
    }

    .why-label {
      font-weight: 600;
      color: #374151;
      display: block;
      margin-bottom: 0.25rem;
    }

    .card-link {
      margin-top: auto;
      color: #2563eb;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.875rem;
    }

    .card-link:hover {
      text-decoration: underline;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }

    @media (max-width: 1024px) {
      .grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 640px) {
      .grid-4 { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
