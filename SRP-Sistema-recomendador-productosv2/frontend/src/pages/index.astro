---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERFILES, arteAvatar, artePerfil, BASE_3D } from '../lib/arte';

const flotantes = [
  { img: `${BASE_3D}/productos/calzado-1.webp`, clase: 'f1', alt: 'Zapatilla 3D' },
  { img: `${BASE_3D}/productos/relojes-2.webp`, clase: 'f2', alt: 'Reloj 3D' },
  { img: `${BASE_3D}/productos/bolsos-1.webp`, clase: 'f3', alt: 'Bolso 3D' },
  { img: `${BASE_3D}/productos/lentes-3.webp`, clase: 'f4', alt: 'Gafas de sol 3D' },
  { img: `${BASE_3D}/productos/otros-3.webp`, clase: 'f5', alt: 'Caja de regalo 3D' },
  { img: `${BASE_3D}/productos/joyeria-1.webp`, clase: 'f6', alt: 'Anillo 3D' },
];
---

<BaseLayout
  title="Compras que te entienden"
  description="Elige tu perfil y mira qué te recomienda un modelo de IA entrenado con reseñas reales de Amazon."
  activo="inicio"
>
  <section class="hero contenedor">
    <div class="hero-texto">
      <p class="eyebrow">Sistema recomendador · Inteligencia Artificial</p>
      <h1>Compras que <em>te entienden</em></h1>
      <p class="lead">
        Elige quién eres y qué te gusta comprar. Un modelo entrenado con 202 mil reseñas reales ordena 71 mil productos
        para ti y te explica por qué.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primario" href="#elegir">Armar mi perfil →</a>
        <a class="btn btn-suave" href="/metricas/">Ver qué tan bueno es</a>
      </div>
      <ul class="hero-datos">
        <li><strong>202 734</strong><span>reseñas reales</span></li>
        <li><strong>71 214</strong><span>productos</span></li>
        <li><strong>0,95</strong><span>HR@10 del modelo</span></li>
      </ul>
    </div>

    <div class="hero-arte" aria-hidden="false">
      <div class="disco"></div>
      {flotantes.map((f) => <img class={`obj ${f.clase}`} src={f.img} alt={f.alt} loading="eager" />)}
    </div>
  </section>

  <section id="elegir" class="paso contenedor" aria-labelledby="t1">
    <header class="paso-cab">
      <span class="num">1</span>
      <div>
        <h2 id="t1">¿Cómo te identificas?</h2>
        <p>Así filtramos las recomendaciones: verás productos para ti y también los unisex.</p>
      </div>
    </header>

    <div class="generos" role="radiogroup" aria-label="Perfil">
      <button class="genero" role="radio" aria-checked="false" data-genero="mujer">
        <span class="arte flota" style="--tinte:#fde5dc"><img src={arteAvatar('mujer')} alt="Personaje 3D: mujer" width="420" height="420" /></span>
        <strong>Mujer</strong>
        <small>Productos para mujer y unisex</small>
        <span class="marca" aria-hidden="true">✓</span>
      </button>
      <button class="genero" role="radio" aria-checked="false" data-genero="hombre">
        <span class="arte flota" style="--tinte:#dcf0ec"><img src={arteAvatar('hombre')} alt="Personaje 3D: hombre" width="420" height="420" /></span>
        <strong>Hombre</strong>
        <small>Productos para hombre y unisex</small>
        <span class="marca" aria-hidden="true">✓</span>
      </button>
      <aside class="nota-gen">
        <strong>Solo filtra productos</strong>
        <p>Tu elección decide si ves productos para mujer, para hombre y los unisex. No pedimos datos personales: se guarda solo en tu navegador.</p>
        <p class="peq">Los personajes y objetos son ilustraciones 3D hechas con Blender.</p>
      </aside>
    </div>
  </section>

  <section id="perfiles" class="paso contenedor bloqueado" aria-labelledby="t2">
    <header class="paso-cab">
      <span class="num">2</span>
      <div>
        <h2 id="t2">¿Qué te gusta comprar?</h2>
        <p>Cada perfil usa el historial real de un cliente de ejemplo con esos gustos.</p>
      </div>
    </header>

    <div class="candado" id="candado">Elige primero cómo te identificas ↑</div>

    <div class="perfiles">
      {PERFILES.map((p) => (
        <a class="perfil" href={`/perfil/?g=mujer&p=${p.id}`} data-perfil={p.id} style={`--tinte:${p.tinte}`}>
          <span class="arte">
            <img src={artePerfil('mujer', p.id)} alt="" width="480" height="480" loading="lazy" data-src-perfil />
          </span>
          <span class="perfil-texto">
            <strong>{p.titulo}</strong>
            <small>{p.descripcion}</small>
          </span>
          <span class="ir" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="como contenedor">
    <h2>Cómo decide el modelo</h2>
    <ol class="pasos-modelo">
      <li><span>1</span><strong>Recupera</strong><p>Un Transformer multilingüe (two-tower) busca los 300 productos más parecidos a lo que compraste.</p></li>
      <li><span>2</span><strong>Mira la secuencia</strong><p>SASRec entiende el orden de tus compras: lo último pesa más que lo primero.</p></li>
      <li><span>3</span><strong>Ordena</strong><p>Un re-ranker GBDT combina 36 señales y calibra qué tan seguro está.</p></li>
      <li><span>4</span><strong>Te lo explica</strong><p>Cada recomendación dice a qué compra tuya se parece o por qué es popular.</p></li>
    </ol>
  </section>

  <script>
    import { artePerfil, type Genero } from '../lib/arte';

    const KEY = 'srp.genero';
    const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('.genero'));
    const seccion = document.getElementById('perfiles')!;
    const tiles = Array.from(document.querySelectorAll<HTMLAnchorElement>('.perfil'));

    function elegir(g: Genero, desplazar: boolean) {
      botones.forEach((b) => {
        const on = b.dataset.genero === g;
        b.setAttribute('aria-checked', String(on));
        b.classList.toggle('activo', on);
      });
      tiles.forEach((t) => {
        const id = t.dataset.perfil!;
        t.href = `/perfil/?g=${g}&p=${id}`;
        const img = t.querySelector('img')!;
        img.src = artePerfil(g, id);
      });
      seccion.classList.remove('bloqueado');
      try { localStorage.setItem(KEY, g); } catch {}
      if (desplazar) seccion.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    botones.forEach((b) => b.addEventListener('click', () => elegir(b.dataset.genero as Genero, true)));

    let previo: string | null = null;
    try { previo = localStorage.getItem(KEY); } catch {}
    if (previo === 'hombre' || previo === 'mujer') elegir(previo, false);
  </script>
</BaseLayout>

<style>
  /* ---------- héroe ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 4.5rem) 0 1rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin: 0.9rem 0 1.1rem;
  }
  .hero h1 em {
    font-style: normal;
    background: linear-gradient(100deg, var(--terra), #ff9a62);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 1.8rem 0 2rem;
  }
  .hero-datos {
    list-style: none;
    display: flex;
    gap: 2rem;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .hero-datos li {
    display: flex;
    flex-direction: column;
  }
  .hero-datos strong {
    font-size: 1.7rem;
    letter-spacing: -0.03em;
  }
  .hero-datos span {
    color: var(--ink-3);
    font-size: 0.85rem;
  }
  .hero-arte {
    position: relative;
    aspect-ratio: 1 / 0.95;
    min-height: 340px;
  }
  .disco {
    position: absolute;
    inset: 6% 6% 4% 6%;
    border-radius: 50%;
    background: radial-gradient(closest-side at 40% 35%, #ffe3d3, #ffd0b8 55%, #f9b99b);
    box-shadow: inset 0 -30px 60px rgba(228, 87, 46, 0.18);
  }
  .obj {
    position: absolute;
    filter: drop-shadow(0 18px 18px rgba(42, 36, 33, 0.22));
    animation: flotar-h 7s ease-in-out infinite;
  }
  .f1 { width: 44%; left: 28%; top: 36%; animation-delay: -1s; z-index: 3; }
  .f2 { width: 22%; left: 4%; top: 6%; animation-delay: -3s; }
  .f3 { width: 34%; right: 0; top: 4%; animation-delay: -2s; z-index: 2; }
  .f4 { width: 30%; left: 2%; bottom: 4%; animation-delay: -4s; z-index: 4; }
  .f5 { width: 27%; right: 2%; bottom: 6%; animation-delay: -5s; z-index: 4; }
  .f6 { width: 22%; left: 40%; top: 0%; animation-delay: -2.5s; }
  @keyframes flotar-h {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4%) rotate(2deg); }
  }

  /* ---------- pasos ---------- */
  .paso {
    padding-top: clamp(3rem, 6vw, 5rem);
    position: relative;
    scroll-margin-top: 5rem;
  }
  .paso-cab {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.6rem;
  }
  .paso-cab h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .paso-cab p {
    color: var(--ink-2);
  }
  .num {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    flex: none;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-weight: 800;
    font-size: 1.15rem;
  }

  .generos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 340px)) minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
  }
  .nota-gen {
    align-self: center;
    padding: 1.4rem 1.6rem;
    border-radius: 22px;
    background: #f6efe8;
    color: var(--ink-2);
    display: grid;
    gap: 0.6rem;
  }
  .nota-gen strong {
    color: var(--ink);
    font-size: 1.1rem;
  }
  .nota-gen .peq {
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  .genero {
    position: relative;
    display: grid;
    gap: 0.2rem;
    justify-items: start;
    text-align: left;
    padding: 0.9rem 0.9rem 1.2rem;
    border: 2px solid transparent;
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--sombra-1);
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .genero .arte {
    width: 100%;
    aspect-ratio: 1.15;
    margin-bottom: 0.7rem;
  }
  .genero strong {
    font-size: 1.5rem;
    padding-inline: 0.5rem;
  }
  .genero small {
    color: var(--ink-3);
    padding-inline: 0.5rem;
  }
  .genero:hover {
    transform: translateY(-6px);
    box-shadow: var(--sombra-2);
  }
  .genero .marca {
    position: absolute;
    top: 1.3rem;
    right: 1.3rem;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--terra);
    color: #fff;
    font-weight: 800;
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
    z-index: 5;
  }
  .genero.activo {
    border-color: var(--terra);
    box-shadow: 0 0 0 5px rgba(228, 87, 46, 0.14), var(--sombra-2);
  }
  .genero.activo .marca {
    transform: scale(1);
  }

  .perfiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.3rem;
    transition: opacity 0.4s, filter 0.4s;
  }
  .perfil {
    position: relative;
    display: grid;
    background: var(--surface);
    border-radius: 26px;
    box-shadow: var(--sombra-1);
    padding: 0.7rem 0.7rem 1rem;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .perfil .arte {
    aspect-ratio: 1.1;
  }
  .perfil-texto {
    display: grid;
    padding: 0.8rem 0.6rem 0;
  }
  .perfil-texto strong {
    font-size: 1.12rem;
    letter-spacing: -0.015em;
  }
  .perfil-texto small {
    color: var(--ink-3);
  }
  .ir {
    position: absolute;
    right: 1.2rem;
    bottom: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    transition: transform 0.25s, background 0.25s;
  }
  .perfil:hover {
    transform: translateY(-6px);
    box-shadow: var(--sombra-2);
  }
  .perfil:hover .ir {
    background: var(--terra);
    transform: translateX(4px);
  }
  .perfil:hover .arte img {
    transform: scale(1.05) rotate(-1.5deg);
  }

  .bloqueado .perfiles {
    opacity: 0.38;
    filter: grayscale(0.7);
    pointer-events: none;
  }
  .candado {
    display: none;
    margin-bottom: 1rem;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    background: var(--sun-s);
    color: #7a5200;
    font-weight: 600;
    width: fit-content;
  }
  .bloqueado .candado {
    display: block;
  }

  /* ---------- cómo funciona ---------- */
  .como {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }
  .como h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 1.5rem;
  }
  .pasos-modelo {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .pasos-modelo li {
    background: var(--surface);
    border-radius: 20px;
    padding: 1.3rem;
    box-shadow: var(--sombra-1);
  }
  .pasos-modelo span {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--terra-s);
    color: var(--terra-d);
    font-weight: 800;
    margin-bottom: 0.8rem;
  }
  .pasos-modelo p {
    color: var(--ink-2);
    font-size: 0.93rem;
    margin-top: 0.3rem;
  }

  @media (max-width: 980px) {
    .generos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .nota-gen {
      grid-column: 1 / -1;
    }
    .hero {
      grid-template-columns: 1fr;
    }
    .perfiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pasos-modelo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .generos,
    .perfiles,
    .pasos-modelo {
      grid-template-columns: 1fr;
    }
  }
</style>
