{
  "version": "v007",
  "dataset": "v2_nih_chest_xray14",
  "manifiesto": "data\\manifiestos\\v2_splits.csv",
  "base_anterior": null,
  "arquitectura": "mobilenetv2_feature_extraction",
  "base_imagenet": "mobilenetv2",
  "base_congelada": true,
  "capas_descongeladas": 0,
  "img_size": [
    224,
    224
  ],
  "batch_size": 32,
  "epochs": 20,
  "epochs_reales": 12,
  "learning_rate": 0.001,
  "dropout_cabeza": 0.3,
  "loss": "binary_crossentropy",
  "normalizacion": "mobilenetv2",
  "recorte_borde_px": 0,
  "augmentacion": [
    "rotation_5deg",
    "zoom_10",
    "translation_10",
    "contrast_8"
  ],
  "class_weights": {
    "0": 0.667,
    "1": 2.0
  },
  "early_stopping": {
    "monitor": "val_auc",
    "mode": "max",
    "patience": 6
  },
  "reduce_lr": true,
  "semilla": 42,
  "notas": "Primera version sobre NIH adulto (v2): MobileNetV2 congelada, misma receta v003. Dominio separado de v1: metricas NO comparables directamente."
}