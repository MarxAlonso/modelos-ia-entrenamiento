---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Analizar reseñas" description="Analiza si un cliente recomendaría un producto basado en su reseña">
  <Navbar />
  
  <div class="container">
    <div class="page-header">
      <h1>Analizador de reseñas</h1>
      <p>Estima las estrellas (1-5) y la probabilidad de que el cliente recomiende el producto.</p>
    </div>

    <div class="card" style="max-width: 700px; margin: 0 auto 3rem;">
      <div class="search-box" style="max-width: 100%; margin: 0;">
        <textarea id="resenaInput" rows="4" placeholder="Escribe una reseña del producto..."></textarea>
        <input type="text" id="productoInput" placeholder="Producto (opcional)" />
        <button onclick="analizar()">Analizar reseña</button>
      </div>
    </div>

    <div id="resultado-container"></div>
  </div>

  <Footer />

  <script>
    async function analizar() {
      const texto = document.getElementById('resenaInput').value.trim();
      const producto = document.getElementById('productoInput').value.trim();
      const container = document.getElementById('resultado-container');

      if (!texto) {
        alert('Por favor escribe una reseña');
        return;
      }

      container.innerHTML = '<div class="empty-state">Analizando...</div>';

      try {
        const res = await fetch('/api/resenas/analizar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ texto, producto: producto || undefined }),
        });

        if (!res.ok) throw new Error('Error al analizar');
        const data = await res.json();

        container.innerHTML = `
          <div class="card">
            <h2>Resultado del análisis</h2>
            <div class="grid-2" style="margin-top: 1.5rem;">
              <div class="stat-card">
                <div class="stat-value">${data.estrellas}</div>
                <div class="stat-label">Estrellas estimadas</div>
              </div>
              <div class="stat-card">
                <div class="stat-value">${(data.recomendaria * 100).toFixed(1)}%</div>
                <div class="stat-label">Probabilidad de recomendar</div>
              </div>
            </div>
            <div style="margin-top: 1.5rem;">
              <h3>Distribución de probabilidad por estrella:</h3>
              <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                ${data.probabilidades_estrellas.map((p, i) => `
                  <div style="flex: 1; background: #f3f4f6; border-radius: 0.5rem; padding: 0.5rem; text-align: center;">
                    <div style="font-size: 0.75rem; color: #6b7280;">${i + 1}★</div>
                    <div style="font-size: 1rem; font-weight: 600; color: #111827;">${(p * 100).toFixed(1)}%</div>
                    <div style="background: #e5e7eb; height: 4px; border-radius: 2px; margin-top: 0.25rem;">
                      <div style="background: #2563eb; height: 100%; width: ${(p * 100).toFixed(1)}%; border-radius: 2px;"></div>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
            <div style="margin-top: 1rem; padding: 1rem; background: ${data.recomendaria > 0.5 ? '#f0fdf4' : '#fef2f2'}; border-radius: 0.5rem; border-left: 4px solid ${data.recomendaria > 0.5 ? '#166534' : '#dc2626'};">
              <strong>${data.recomendaria > 0.5 ? '✓ El cliente probablemente RECOMIENDA este producto' : '✗ El cliente probablemente NO recomienda este producto'}</strong>
            </div>
            ${data.laya ? `
            <div style="margin-top: 1rem; padding: 1rem; background: #f9fafb; border-radius: 0.5rem; border-left: 4px solid #7c3aed;">
              <strong style="color: #7c3aed;">Laya (referencia):</strong><br>
              Rating estimado: ${data.laya.rating_estimado}★ | Recomendaría: ${(data.laya.recomendaria * 100).toFixed(1)}%
            </div>` : ''}
          </div>
        `;
      } catch (err) {
        container.innerHTML = `<div class="card" style="color: #dc2626;"><h3>Error</h3><p>${err.message}</p></div>`;
      }
    }

    document.getElementById('resenaInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        analizar();
      }
    });
  </script>

  <style>
    .search-box {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .search-box textarea {
      width: 100%;
      padding: 1rem 1.25rem;
      border: 2px solid #e5e7eb;
      border-radius: 0.75rem;
      font-size: 1rem;
      font-family: inherit;
      outline: none;
      resize: vertical;
      min-height: 120px;
    }

    .search-box textarea:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .search-box input {
      width: 100%;
      padding: 0.875rem 1.25rem;
      border: 2px solid #e5e7eb;
      border-radius: 0.75rem;
      font-size: 1rem;
      outline: none;
    }

    .search-box input:focus {
      border-color: #2563eb;
    }

    .search-box button {
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 0.75rem;
      padding: 0.875rem;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      width: 100%;
    }

    .search-box button:hover {
      background: #1d4ed8;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    @media (max-width: 640px) {
      .grid-2 { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
