---
interface Props {
  activo?: 'inicio' | 'perfil' | 'metricas' | 'resenas';
}
const { activo = 'inicio' } = Astro.props;
const enlaces = [
  { id: 'inicio', href: '/', texto: 'Inicio' },
  { id: 'resenas', href: '/resenas/', texto: 'Reseñas' },
  { id: 'metricas', href: '/metricas/', texto: 'Métricas' },
];
---

<header class="barra">
  <div class="contenedor barra-in">
    <a href="/" class="logo" aria-label="SRP · Inicio">
      <span class="logo-marca" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="22" height="22" fill="none">
          <path d="M8 11h16l-1.4 12.2a2 2 0 0 1-2 1.8H11.4a2 2 0 0 1-2-1.8L8 11Z" fill="#fff" />
          <path d="M12 11V9.5a4 4 0 0 1 8 0V11" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </span>
      <span class="logo-texto">SRP<small>recomendador</small></span>
    </a>

    <nav class="enlaces" aria-label="Principal">
      {enlaces.map((e) => (
        <a href={e.href} class:list={['enlace', { activo: activo === e.id }]} aria-current={activo === e.id ? 'page' : undefined}>
          {e.texto}
        </a>
      ))}
    </nav>

    <a href="/#elegir" class="btn btn-primario cta">Armar mi perfil</a>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .barra-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.2rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .logo-marca {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 14px;
    background: linear-gradient(145deg, #ff7d4f, var(--terra) 55%, var(--terra-d));
    box-shadow: 0 8px 18px rgba(228, 87, 46, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .logo-texto {
    display: flex;
    flex-direction: column;
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .logo-texto small {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 0.2rem;
  }
  .enlaces {
    display: flex;
    gap: 0.25rem;
  }
  .enlace {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--ink-2);
    transition: background 0.15s, color 0.15s;
  }
  .enlace:hover {
    background: #f1ebe4;
    color: var(--ink);
  }
  .enlace.activo {
    background: var(--ink);
    color: #fff;
  }
  .cta {
    padding: 0.6rem 1.2rem;
    font-size: 0.92rem;
  }
  @media (max-width: 720px) {
    .cta {
      display: none;
    }
    .logo-texto small {
      display: none;
    }
  }
</style>
